{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'No root dependencies - each game installs its own during the build'",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/poker", "destination": "/high-rollers/holdem/", "permanent": true },
    { "source": "/poker/(.*)", "destination": "/high-rollers/holdem/$1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
